# Variables del backend (server/). Copiá a .env y completá. NUNCA subas .env al repo.
# En producción viven sólo en /opt/shippear/.env del servidor.

# IA — cadena de proveedores separada por comas; si el primero falla se usa el siguiente.
# Opciones: xai (Grok) | local (Ollama nativo, Broly vía túnel) | openai | local-openai (LM Studio/vLLM)
AI_PROVIDER=xai,local
XAI_API_KEY=
# AI_XAI_MODEL=grok-4.20-0309-non-reasoning
# AI_XAI_TIMEOUT_MS=30000
AI_LOCAL_BASE_URL=http://172.19.0.1:11435
AI_LOCAL_MODEL=qwen3.5:4b
# AI_LOCAL_VISION_MODEL=        # vacío = el mismo modelo (qwen3.5 ya lee fotos)
# AI_LOCAL_KEEP_ALIVE=30m
# AI_LOCAL_TIMEOUT_MS=120000
# Voz a texto (audios del chat). Primero xAI (misma XAI_API_KEY); whisper en Broly de respaldo.
# AI_STT=xai,whisper,openai
# AI_XAI_STT_MODEL=grok-voice-transcribe-2.0
# AI_WHISPER_URL=http://172.19.0.1:11436   # faster-whisper en Broly vía túnel (opcional)
# AI_WHISPER_MODEL=small
# Sólo si AI_PROVIDER=openai:
# OPENAI_API_KEY=
# AI_MODEL=gpt-4.1-mini
# AI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
AI_CHAT_PER_HOUR=40
AI_CHAT_PER_DAY=200

# Base de datos
POSTGRES_PASSWORD=
DATABASE_URL=postgres://shippear:CAMBIAR@localhost:5432/shippear

# Sesión / login
SESSION_SECRET=
COOKIE_SECURE=true
LOGIN_TOKEN_MINUTES=10
PUBLIC_URL=https://shippear.arcadeestudio.com

# Email (código de ingreso)
SMTP_HOST=mail.arcadeestudio.com
SMTP_PORT=587
SMTP_USER=saldoafavor@arcadeestudio.com
SMTP_PASS=
SMTP_TLS_REJECT_UNAUTHORIZED=true
MAIL_FROM="Saldo a Favor" <saldoafavor@arcadeestudio.com>
